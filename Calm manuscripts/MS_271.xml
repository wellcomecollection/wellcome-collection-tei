              <author>Others</author>
              <title type="original">Livre de receptes exprouveés</title>
              <textLang mainLang="fr" source="IANA">French</textLang>
              <textLang mainLang="la" source="IANA">Latin</textLang>
              <filiation></filiation>
            </msItem>
          </msContents>
